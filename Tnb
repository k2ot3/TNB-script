-- TAB SWITCHING
----------------------------------------------------------------
local function switchTab(selected)
	chatPage.Visible = (selected == "chat")
	dropPage.Visible = (selected == "drop")
	interactPage.Visible = (selected == "interact")
	espPage.Visible = (selected == "esp")
	flyPage.Visible = (selected == "fly")

	local function styleTab(tab, active)
		if active then
			tab.BackgroundColor3 = Color3.fromRGB(0, 130, 60)
			tab.TextColor3 = Color3.new(1, 1, 1)
		else
			tab.BackgroundColor3 = Color3.fromRGB(32, 32, 40)
			tab.TextColor3 = Color3.fromRGB(160, 160, 170)
		end
	end

	styleTab(chatTab, selected == "chat")
	styleTab(dropTab, selected == "drop")
	styleTab(interactTab, selected == "interact")
	styleTab(espTab, selected == "esp")
	styleTab(flyTab, selected == "fly")
end

chatTab.MouseButton1Click:Connect(function() switchTab("chat") end)
dropTab.MouseButton1Click:Connect(function() switchTab("drop") end)
interactTab.MouseButton1Click:Connect(function() switchTab("interact") end)
espTab.MouseButton1Click:Connect(function() switchTab("esp") end)
flyTab.MouseButton1Click:Connect(function() switchTab("fly") end)

