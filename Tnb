-- ESP LOGIC (Hotbar only)
----------------------------------------------------------------
local ESP_ENABLED = true
local MAX_DISTANCE = 2000
local PLAYER_COLOR = Color3.fromRGB(0, 255, 100)
local ENEMY_COLOR = Color3.fromRGB(255, 60, 60)
local DROPPED_COLOR = Color3.fromRGB(255, 200, 50)

local playerESP = {}
local droppedESP = {}

local function createBillboard(adornee, text, color, size)
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "ESP_Billboard"
	billboard.Adornee = adornee
	billboard.Size = size or UDim2.new(0, 200, 0, 50)
	billboard.StudsOffset = Vector3.new(0, 3, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = MAX_DISTANCE

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = color or Color3.fromRGB(255, 255, 255)
	label.TextStrokeTransparency = 0.3
	label.TextStrokeColor3 = Color3.new(0, 0, 0)
	label.Font = Enum.Font.GothamBold
	label.TextSize = 14
	label.Parent = billboard

	billboard.Parent = adornee
	return billboard, label
end

local function removePlayerESP(plr)
	if playerESP[plr] then
		for _, obj in pairs(playerESP[plr]) do
			if typeof(obj) == "Instance" then
				obj:Destroy()
			end
		end
		playerESP[plr] = nil
	end
end

local function updatePlayerESP(plr)
	if plr == localPlayer then return end

	local character = plr.Character
	if not character then
		removePlayerESP(plr)
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
	if not humanoid or not root or humanoid.Health <= 0 then
		removePlayerESP(plr)
		return
	end

	if not playerESP[plr] then
		playerESP[plr] = {}

		local highlight = Instance.new("Highlight")
		highlight.Name = "ESP_Highlight"
		highlight.Adornee = character
		highlight.FillColor = ENEMY_COLOR
		highlight.OutlineColor = Color3.new(1, 1, 1)
		highlight.FillTransparency = 0.7
		highlight.OutlineTransparency = 0
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.Parent = character
		playerESP[plr].highlight = highlight

		local billboard, label = createBillboard(root, "", PLAYER_COLOR, UDim2.new(0, 220, 0, 60))
		playerESP[plr].billboard = billboard
		playerESP[plr].label = label
	end

	local myRoot = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
	local distance = myRoot and math.floor((root.Position - myRoot.Position).Magnitude) or 0

	-- Equipped tool
	local equipped = "None"
	for _, item in ipairs(character:GetChildren()) do
		if item:IsA("Tool") then
			equipped = item.Name
			break
		end
	end

	-- Hotbar only (first 9 tools in Backpack)
	local hotbarItems = {}
	local backpack = plr:FindFirstChild("Backpack")
	if backpack then
		local count = 0
		for _, item in ipairs(backpack:GetChildren()) do
			if item:IsA("Tool") then
				count += 1
				if count <= 9 then
					table.insert(hotbarItems, item.Name)
				end
			end
		end
	end

	local invText = equipped
	if #hotbarItems > 0 then
		invText = equipped .. " | HB: " .. table.concat(hotbarItems, ", ")
	end

	playerESP[plr].label.Text = string.format(
		"%s  [%dm]\nHP: %d/%d\nHolding: %s",
		plr.Name,
		distance,
		math.floor(humanoid.Health),
		math.floor(humanoid.MaxHealth),
		invText
	)

	if plr.Team and localPlayer.Team and plr.Team == localPlayer.Team then
		playerESP[plr].highlight.FillColor = Color3.fromRGB(0, 200, 255)
	else
		playerESP[plr].highlight.FillColor = ENEMY_COLOR
	end
end

local function isDroppedTool(obj)
	if not obj:IsA("Tool") then return false end
	local parent = obj.Parent
	if not parent then return false end
	if parent:IsA("Model") and parent:FindFirstChildOfClass("Humanoid") then return false end
	if parent.Name == "Backpack" then return false end
	if parent:IsA("Player") then return false end
	return true
end

local function updateDroppedESP()
	for tool, data in pairs(droppedESP) do
		if not tool or not tool.Parent or not isDroppedTool(tool) then
			if data.billboard then data.billboard:Destroy() end
			droppedESP[tool] = nil
		end
	end

	for _, obj in ipairs(workspace:GetDescendants()) do
		if isDroppedTool(obj) and not droppedESP[obj] then
			local handle = obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart")
			if handle then
				local billboard, label = createBillboard(handle, "📦 " .. obj.Name, DROPPED_COLOR, UDim2.new(0, 150, 0, 30))
				billboard.StudsOffset = Vector3.new(0, 1.5, 0)
				droppedESP[obj] = {billboard = billboard, label = label}
			end
		end
	end
end

local function clearAllESP()
	for plr, _ in pairs(playerESP) do
		removePlayerESP(plr)
	end
	for tool, data in pairs(droppedESP) do
		if data.billboard then data.billboard:Destroy() end
	end
	droppedESP = {}
end

local function setESP(state)
	ESP_ENABLED = state
	if ESP_ENABLED then
		espToggle.Text = "ON"
		espToggle.BackgroundColor3 = Color3.fromRGB(35, 155, 65)
		espStatus.Text = "Status: Enabled"
		espStatus.TextColor3 = Color3.fromRGB(0, 210, 95)
	else
		espToggle.Text = "OFF"
		espToggle.BackgroundColor3 = Color3.fromRGB(165, 35, 35)
		espStatus.Text = "Status: Disabled"
		espStatus.TextColor3 = Color3.fromRGB(255, 95, 95)
		clearAllESP()
	end
end

espToggle.MouseButton1Click:Connect(function()
	setESP(not ESP_ENABLED)
end)

RunService.RenderStepped:Connect(function()
	if not ESP_ENABLED then return end
	for _, plr in ipairs(Players:GetPlayers()) do
		updatePlayerESP(plr)
	end
	updateDroppedESP()
end)

Players.PlayerRemoving:Connect(function(plr)
	removePlayerESP(plr)
end)

setESP(true)

