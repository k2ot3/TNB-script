----------------------------------------------------------------
-- DRAGGABLE
----------------------------------------------------------------
local dragging = false
local dragStart, startPos

topBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = mainFrame.Position
	end
end)

topBar.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = false
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)

----------------------------------------------------------------
-- CHAT SPAM LOGIC
----------------------------------------------------------------
local chatSpamming = false
local chatCount = 0

local function getChannel()
	local channels = TextChatService:FindFirstChild("TextChannels")
	if not channels then return nil end
	return channels:FindFirstChild("RBXGeneral") or channels:GetChildren()[1]
end

local function startChatSpam()
	if chatSpamming then return end
	local msg = chatBox.Text
	if msg == "" or msg:match("^%s*$") then
		chatStatus.Text = "Status: Type a message first!"
		chatStatus.TextColor3 = Color3.fromRGB(255, 85, 85)
		return
	end

	local channel = getChannel()
	if not channel then
		chatStatus.Text = "Status: No chat channel found"
		chatStatus.TextColor3 = Color3.fromRGB(255, 85, 85)
		return
	end

	chatSpamming = true
	chatCount = 0
	chatStart.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
	chatStatus.Text = "Status: Spamming..."
	chatStatus.TextColor3 = Color3.fromRGB(0, 240, 110)

	task.spawn(function()
		while chatSpamming do
			pcall(function()
				channel:SendAsync(msg)
			end)
			pcall(function()
				local events = game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents")
				if events and events:FindFirstChild("SayMessageRequest") then
					events.SayMessageRequest:FireServer(msg, "All")
				end
			end)
			chatCount += 1
			chatStatus.Text = "Status: Spamming... Sent " .. chatCount .. " times"
			task.wait(0.6)
		end
	end)
end

local function stopChatSpam()
	chatSpamming = false
	chatStart.BackgroundColor3 = Color3.fromRGB(0, 145, 65)
	chatStatus.Text = "Status: Stopped after " .. chatCount .. " messages"
	chatStatus.TextColor3 = Color3.fromRGB(255, 175, 45)
end

chatStart.MouseButton1Click:Connect(startChatSpam)
chatStop.MouseButton1Click:Connect(stopChatSpam)

----------------------------------------------------------------
-- DROP SPAM LOGIC
----------------------------------------------------------------
local dropSpamming = false

local function equipFirstTool()
	local character = player.Character
	if not character then return false end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return false end

	local backpack = player:FindFirstChild("Backpack")
	if backpack then
		for _, item in ipairs(backpack:GetChildren()) do
			if item:IsA("Tool") then
				humanoid:EquipTool(item)
				return true
			end
		end
	end
	for _, item in ipairs(character:GetChildren()) do
		if item:IsA("Tool") then
			return true
		end
	end
	return false
end

local function startDropSpam()
	if dropSpamming then return end
	if not equipFirstTool() then
		dropStatus.Text = "Status: No tool found!"
		dropStatus.TextColor3 = Color3.fromRGB(255, 85, 85)
		return
	end

	dropSpamming = true
	dropStart.Text = "RUNNING"
	dropStart.BackgroundColor3 = Color3.fromRGB(25, 90, 40)
	dropStatus.Text = "Status: Drop spamming..."
	dropStatus.TextColor3 = Color3.fromRGB(0, 240, 110)

	task.spawn(function()
		while dropSpamming do
			pcall(function()
				local channel = getChannel()
				if channel then
					channel:SendAsync("/drop")
				end
			end)
			pcall(function()
				local events = game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents")
				if events and events:FindFirstChild("SayMessageRequest") then
					events.SayMessageRequest:FireServer("/drop", "All")
				end
			end)
			task.wait(0.15)
		end
	end)
end

local function stopDropSpam()
	dropSpamming = false
	dropStart.Text = "START"
	dropStart.BackgroundColor3 = Color3.fromRGB(0, 145, 65)
	dropStatus.Text = "Status: Stopped"
	dropStatus.TextColor3 = Color3.fromRGB(255, 175, 45)
end

dropStart.MouseButton1Click:Connect(startDropSpam)
dropStop.MouseButton1Click:Connect(stopDropSpam)

----------------------------------------------------------------
-- INSTANT INTERACT + SPAM INTERACT LOGIC
----------------------------------------------------------------
local instantEnabled = true
local spamInteractEnabled = false

local function makeInstant(prompt)
	if prompt:IsA("ProximityPrompt") then
		prompt.HoldDuration = 0
		prompt.RequiresLineOfSight = false
		if prompt.MaxActivationDistance < 15 then
			prompt.MaxActivationDistance = 15
		end
	end
end

local function applyToAll()
	for _, obj in ipairs(workspace:GetDescendants()) do
		makeInstant(obj)
	end
end

workspace.DescendantAdded:Connect(function(obj)
	if instantEnabled then
		makeInstant(obj)
	end
end)

ProximityPromptService.PromptShown:Connect(function(prompt)
