end)

local function updateInteractStatus()
	local status = {}
	if instantEnabled then
		table.insert(status, "Instant ON")
	else
		table.insert(status, "Instant OFF")
	end
	if spamInteractEnabled then
		table.insert(status, "Spam Interact ON")
	else
		table.insert(status, "Spam Interact OFF")
	end
	interactStatus.Text = "Status: " .. table.concat(status, "  |  ")
	interactStatus.TextColor3 = (instantEnabled or spamInteractEnabled) and Color3.fromRGB(0, 210, 95) or Color3.fromRGB(255, 95, 95)
end

local function setInstant(state)
	instantEnabled = state
	if instantEnabled then
		interactToggle.Text = "Instant: ON"
		interactToggle.BackgroundColor3 = Color3.fromRGB(35, 155, 65)
		applyToAll()
	else
		interactToggle.Text = "Instant: OFF"
		interactToggle.BackgroundColor3 = Color3.fromRGB(165, 35, 35)
	end
	updateInteractStatus()
end

local function spamNearbyPrompts()
	local character = player.Character
	if not character then return end
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then return end

	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("ProximityPrompt") and obj.Enabled then
			local parent = obj.Parent
			local part = parent:IsA("BasePart") and parent or parent:FindFirstChildWhichIsA("BasePart")
			if part then
				local distance = (part.Position - root.Position).Magnitude
				if distance <= (obj.MaxActivationDistance + 5) then
					pcall(function()
						obj:InputHoldBegin()
						task.wait(0.03)
						obj:InputHoldEnd()
					end)
				end
			end
		end
	end
end

local function setSpamInteract(state)
	spamInteractEnabled = state
	if spamInteractEnabled then
		spamInteractBtn.Text = "Spam Interact: ON"
		spamInteractBtn.BackgroundColor3 = Color3.fromRGB(35, 155, 65)
	else
		spamInteractBtn.Text = "Spam Interact: OFF"
		spamInteractBtn.BackgroundColor3 = Color3.fromRGB(175, 35, 35)
	end
	updateInteractStatus()
end

